APP_NAME=AttendXsuite
ENVIRONMENT=development
PORT=8070
MONGODB_URI=mongodb://127.0.0.1:27017/attendxsuite
MONGODB_DATABASE=attendxsuite
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=43200
CLIENT_ORIGINS=http://127.0.0.1:8061,http://localhost:8061
COMPANY_TIMEZONE=Asia/Kolkata

FACE_ENGINE=huggingface
HF_FACE_API_URL=https://ashutoshtiwariazby-attendxsuite-face-api.hf.space
HF_FACE_API_TOKEN=replace_with_secret_token
HF_FACE_MODEL=buffalo_s
HF_TIMEOUT_SECONDS=60
FACE_MATCH_THRESHOLD=0.48
FACE_MATCH_MARGIN=0.06
FACE_SCAN_FRAME_COUNT=5
FACE_SCAN_CONSENSUS=3
